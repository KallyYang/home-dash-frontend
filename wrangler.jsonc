{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "home-dash-frontend",
  "main": "worker.ts",
  "compatibility_date": "2025-03-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "triggers": { "crons": ["*/5 * * * *"] },
  "kv_namespaces": [{ "binding": "MONITOR_STATE" }],
  "secrets": {
    "required": ["TAILSCALE_API_KEY", "CF_API_TOKEN", "CF_ACCOUNT_ID", "BARK_KEY"]
  },
  "vars": {
    "MONITOR_TAILSCALE_NODES": "[]",
    "MONITOR_CLOUDFLARED_TUNNELS": "[]",
    "OFFLINE_THRESHOLD_MINUTES": "10",
    "FAIL_THRESHOLD": "2",
    "BARK_SERVER": "https://api.day.app"
  }
  // "vars": {
  //   "API_BASE": "https://api.home-dash.yourdomain.com"
  // }
  // Optional bindings:
  // "r2_buckets": [{ "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "home-dash-cache" }]
}
